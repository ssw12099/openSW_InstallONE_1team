# 이 파일을 .env로 복사하세요. 실제 키는 .env에만 입력합니다.
# 한 줄 KEY=VALUE. 변수 확장/여러 줄/인라인 주석은 지원하지 않습니다.
HAIGPT_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
HAIGPT_API_KEY=
# 계정 모델 목록에서 확인한 ID. 기존 사용자가 선택한 모델: gpt-6-luna
HAIGPT_MODEL=
HAIGPT_TIMEOUT_SECONDS=45
HAIGPT_MAX_TOKENS=1024

# VM 미준비: 비워 둡니다. 현재 웹은 이 설정을 읽거나 SSH를 실행하지 않습니다.
VM_TARGETS_JSON={}

# 선택 사항. 생략하면 1번 success, 2번 connection_failed.
# 좌석은 1·2번에서 최대 2개. 시나리오: success, reused, connection_failed,
# install_failed, verification_failed, outcome_unknown.
# MOCK_SEATS_JSON=[{"id":"1","scenario":"reused"},{"id":"2","scenario":"verification_failed"}]
