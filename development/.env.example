# 이 파일을 .env로 복사해서 값을 채우세요. .env는 Git에 올라가지 않습니다.
# API 키·비밀번호는 .env에만 넣고, 채팅·코드·커밋에는 넣지 마세요.

# ── AI 해석 ───────────────────────────────────────────
# none(규칙 기반만) / haigpt / groq / ollama
LLM_PROVIDER=none
# HAI-GPT(한림대 API Gateway): LLM_PROVIDER=haigpt 와 LLM_API_KEY만 적으면 나머지는 기본값을 써요.
#   기본 주소  https://factchat-cloud.mindlogic.ai/v1/gateway  (채팅 경로 /chat/completions/)
#   기본 모델  gemini-3.5-flash-lite  → 대시보드 '모델' 탭의 다른 ID로 바꾸려면 LLM_MODEL에 적기
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_CHAT_PATH=
# 보내지 않는 게 기본이에요 (temperature를 거부하는 모델이 있음). 필요하면 0 같은 값을 적기
LLM_TEMPERATURE=
# 예) Groq 무료 플랜: LLM_PROVIDER=groq 와 LLM_API_KEY (주소·모델은 기본값 openai/gpt-oss-120b)
# 예) Ollama(로컬):  LLM_PROVIDER=ollama, LLM_MODEL=설치한 모델 이름(예: qwen2.5:7b)
LLM_TIMEOUT=20

# ── 실제 좌석(WinRM) 접속 계정 ─────────────────────────
INSTALLONE_WINRM_USER=labadmin
INSTALLONE_WINRM_PASSWORD=

# ── 기타 ─────────────────────────────────────────────
# 모의 좌석 속도 배율 (1이 기본, 0이면 즉시 끝남)
INSTALLONE_MOCK_SPEED=1
# 서버 주소 (python -m src.app)
INSTALLONE_HOST=127.0.0.1
INSTALLONE_PORT=8000
