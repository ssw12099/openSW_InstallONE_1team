# 이 파일을 .env로 복사해서 값을 채우세요. .env는 Git에 올라가지 않습니다.
# API 키·비밀번호는 .env에만 넣고, 채팅·코드·커밋에는 넣지 마세요.

# ── AI 해석 ───────────────────────────────────────────
# none(규칙 기반만) / haigpt / groq / ollama
LLM_PROVIDER=none
# HaiGPT: 학교 API 안내에 나온 접속 주소(…/v1 형태)와 모델 이름을 적으세요.
# (OpenAI 호환 /chat/completions 형식 기준. 형식이 다르면 src/ai/providers.py를 맞춥니다)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# 예) Groq 무료 플랜: LLM_PROVIDER=groq 와 LLM_API_KEY만 적으면 주소·모델은 기본값(openai/gpt-oss-120b)
# 예) Ollama(로컬):  LLM_PROVIDER=ollama, LLM_MODEL=설치한 모델 이름(예: qwen2.5:7b)
LLM_TIMEOUT=20

# ── 실제 좌석(WinRM) 접속 계정 ─────────────────────────
INSTALLONE_WINRM_USER=labadmin
INSTALLONE_WINRM_PASSWORD=

# ── 기타 ─────────────────────────────────────────────
# 모의 좌석 속도 배율 (1이 기본, 0이면 즉시 끝남)
INSTALLONE_MOCK_SPEED=1
# 서버 주소 (python -m src.app)
INSTALLONE_HOST=127.0.0.1
INSTALLONE_PORT=8000
